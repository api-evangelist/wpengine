          "name": "List report templates",
          "request": {
            "name": "List report templates",
            "description": {
              "content": "# Description\nReturns a list of report templates available for Site Reports.\n\nTemplates define the structure, branding, and sections included in generated reports.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "site_reports",
                "templates"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "account_id",
                  "value": "<uuid>",
                  "description": "(Required) Account ID to filter templates. This parameter is required."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
