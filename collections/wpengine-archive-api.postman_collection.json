          "name": "List archives for a WordPress installation",
          "request": {
            "name": "List archives for a WordPress installation",
            "description": {
              "content": "Retrieves a paginated list of archives for a WordPress installation.\nArchives create downloadable zip files from backups.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "installs",
                ":install_id",
                "archives"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "(Optional) The number of records to return"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "(Optional) The first record of the result set to be retrieved"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "install_id",
                  "description": "(Required) ID of install"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
