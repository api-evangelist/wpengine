            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/accounts/:account_id/account_users",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "ID of account"
              }
            ]
          },
          "docs": "List your account users"
        },
        {
          "info": {
            "name": "Create a new account user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/accounts/:account_id/account_users",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "ID of account"
              }
            ]
