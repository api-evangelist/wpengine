            "name": "Get an account user by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/accounts/:account_id/account_users/:user_id",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
